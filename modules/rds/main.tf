# MySQL 8.0, Multi-AZ, Graviton (t4g) instance class — the specific choices from the deployment
# plan, hand-written rather than wrapped from a community module because the destroy/snapshot
# lifecycle here is app-specific: this instance is meant to be torn down between demos, not run
# 24/7, so deletion_protection is deliberately OFF but a final snapshot is always taken.

resource "random_password" "master" {
  length  = 32
  special = false # avoid characters MySQL connection strings need escaping for
}

resource "aws_secretsmanager_secret" "db_credentials" {
  name        = "${var.name_prefix}/db-credentials"
  kms_key_id  = var.kms_key_arn
  description = "RDS MySQL master credentials for ${var.name_prefix}, generated by Terraform"
  tags        = var.tags
}

resource "aws_secretsmanager_secret_version" "db_credentials" {
  secret_id = aws_secretsmanager_secret.db_credentials.id
  secret_string = jsonencode({
    username = var.master_username
    password = random_password.master.result
    host     = aws_db_instance.this.address
    port     = aws_db_instance.this.port
    dbname   = var.database_name
  })
}

resource "aws_db_subnet_group" "this" {
  name       = "${var.name_prefix}-db-subnets"
  subnet_ids = var.private_subnet_ids
  tags       = var.tags
}

resource "aws_security_group" "db" {
  name_prefix = "${var.name_prefix}-db-"
  description = "Allows MySQL (3306) only from the EKS node security group"
  vpc_id      = var.vpc_id

  ingress {
    description     = "MySQL from EKS nodes"
    from_port       = 3306
    to_port         = 3306
    protocol        = "tcp"
    security_groups = [var.eks_node_security_group_id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = var.tags

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "this" {
  identifier     = "${var.name_prefix}-mysql"
  engine         = var.engine # "mariadb" by default — see variables.tf for why
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage     = var.allocated_storage_gb
  max_allocated_storage = var.max_allocated_storage_gb
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = var.kms_key_arn

  db_name  = var.database_name
  username = var.master_username
  password = random_password.master.result
  port     = 3306

  multi_az               = var.multi_az
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.db.id]

  backup_retention_period = var.backup_retention_days
  backup_window           = "03:00-04:00"
  maintenance_window      = "mon:04:30-mon:05:30"

  # Deliberately off: this instance is meant to be destroyed between demos (see the deployment
  # plan's cost runbook), which deletion_protection would block. skip_final_snapshot is
  # deliberately false — every destroy still leaves a snapshot to restore from.
  deletion_protection       = false
  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.name_prefix}-mysql-final-${formatdate("YYYYMMDD-hhmmss", timestamp())}"
  copy_tags_to_snapshot     = true

  auto_minor_version_upgrade = true
  apply_immediately          = var.apply_immediately

  tags = var.tags

  # final_snapshot_identifier intentionally NOT in a lifecycle.ignore_changes block: it must
  # re-evaluate timestamp() fresh on every destroy so repeated destroy/apply cycles (the normal
  # "spin up for a demo, tear down after" workflow) never collide on a reused snapshot name.
  # The trade-off is that `terraform plan` shows this one attribute as perpetually changing —
  # harmless cosmetic noise, since changing it doesn't force replacement of the instance.
}
