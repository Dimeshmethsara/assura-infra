data "aws_caller_identity" "current" {}

locals {
  name_prefix = "assura-${var.environment}"
}

module "vpc" {
  source       = "../../modules/vpc"
  name_prefix  = local.name_prefix
  cluster_name = "${local.name_prefix}-eks"
  aws_region   = var.aws_region
  vpc_cidr     = var.vpc_cidr
  tags         = var.tags
}

module "eks" {
  source              = "../../modules/eks"
  cluster_name        = "${local.name_prefix}-eks"
  kubernetes_version  = var.kubernetes_version
  vpc_id              = module.vpc.vpc_id
  private_subnet_ids  = module.vpc.private_subnet_ids
  node_instance_types = var.node_instance_types
  node_min_size       = var.node_min_size
  node_max_size       = var.node_max_size
  node_desired_size   = var.node_desired_size
  tags                = var.tags
}

module "kms" {
  source      = "../../modules/kms"
  name_prefix = local.name_prefix
  tags        = var.tags
}

module "ecr" {
  source      = "../../modules/ecr"
  name_prefix = local.name_prefix
  kms_key_arn = module.kms.data_key_arn
  tags        = var.tags
}

module "s3_uploads" {
  source        = "../../modules/s3-uploads"
  name_prefix   = local.name_prefix
  unique_suffix = data.aws_caller_identity.current.account_id
  kms_key_arn   = module.kms.data_key_arn
  tags          = var.tags
}

module "iam_irsa" {
  source                       = "../../modules/iam-irsa"
  name_prefix                  = local.name_prefix
  oidc_provider_arn            = module.eks.oidc_provider_arn
  oidc_provider                = module.eks.oidc_provider
  s3_uploads_bucket_arn        = module.s3_uploads.bucket_arn
  kms_data_key_arn             = module.kms.data_key_arn
  kms_cosign_key_arn           = module.kms.cosign_key_arn
  ecr_repository_arns          = values(module.ecr.repository_arns)
  github_gitops_pat_secret_arn = aws_secretsmanager_secret.github_gitops_pat.arn
  tags                         = var.tags

  service_accounts = {
    "backend" = {
      namespace = "assura-app"
      name      = "assura-backend"
    }
    "external-secrets" = {
      namespace = "external-secrets"
      name      = "external-secrets"
    }
    "fluent-bit" = {
      namespace = "observability"
      name      = "fluent-bit"
    }
    "jenkins-agent" = {
      namespace = "jenkins-agents"
      name      = "jenkins-agent"
    }
    "aws-load-balancer-controller" = {
      namespace = "kube-system"
      name      = "aws-load-balancer-controller"
    }
  }
}

module "rds" {
  source                     = "../../modules/rds"
  name_prefix                = local.name_prefix
  vpc_id                     = module.vpc.vpc_id
  private_subnet_ids         = module.vpc.private_subnet_ids
  eks_node_security_group_id = module.eks.node_security_group_id
  kms_key_arn                = module.kms.data_key_arn
  multi_az                   = var.rds_multi_az
  instance_class             = var.rds_instance_class
  tags                       = var.tags
}

resource "random_password" "jwt_key" {
  length  = 44 # -> 32+ raw bytes once base64-encoded, comfortably above HMAC-SHA256's minimum
  special = true
}

resource "aws_secretsmanager_secret" "jwt" {
  name        = "${local.name_prefix}/jwt"
  kms_key_id  = module.kms.data_key_arn
  description = "JWT signing key for ${local.name_prefix}, generated by Terraform"
  tags        = var.tags
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = jsonencode({ key = random_password.jwt_key.result })
}

# Terraform creates the container but NOT a real value: a GitHub PAT can't be generated by
# Terraform, only by a human via GitHub's own UI (Settings -> Developer settings -> Fine-grained
# tokens), scoped to Contents:Read-and-write on just the assura-gitops repo. After apply, set it:
#   aws secretsmanager put-secret-value --secret-id ${local.name_prefix}/github-gitops-pat \
#     --secret-string '{"token":"<paste PAT here>"}'
# The jenkins-agent IRSA role (see modules/iam-irsa) can read this one secret and nothing else in
# Secrets Manager beyond what its other statements already grant — see AssuraBackend/Jenkinsfile
# and assura-frontend/Jenkinsfile's "Update GitOps manifest" stage for how it's consumed.
resource "aws_secretsmanager_secret" "github_gitops_pat" {
  name        = "${local.name_prefix}/github-gitops-pat"
  kms_key_id  = module.kms.data_key_arn
  description = "GitHub PAT Jenkins uses to push image-tag updates to assura-gitops. Value set manually post-apply — see this resource's comment."
  tags        = var.tags
}

resource "aws_secretsmanager_secret_version" "github_gitops_pat" {
  secret_id     = aws_secretsmanager_secret.github_gitops_pat.id
  secret_string = jsonencode({ token = "REPLACE_ME_MANUALLY" })

  lifecycle {
    ignore_changes = [secret_string] # so a manual `put-secret-value` isn't clobbered by the next apply
  }
}

module "waf" {
  source      = "../../modules/waf"
  name_prefix = local.name_prefix
  enable_waf  = var.enable_waf
  alb_arn     = var.waf_alb_arn
  tags        = var.tags
}

# ArgoCD is the ONLY Helm release Terraform ever installs directly into the cluster — everything
# else (AWS LB Controller, External Secrets, Kyverno, kube-prometheus-stack, Fluent Bit, Jenkins,
# and both app charts) is an ArgoCD-managed Application from here on, defined in the assura-gitops
# repo, never touched by Terraform or by a human running kubectl.
resource "helm_release" "argocd" {
  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = var.argocd_chart_version
  namespace        = "argocd"
  create_namespace = true

  depends_on = [module.eks]
}

# Bootstraps the App-of-Apps pattern: this one Application points at assura-gitops/apps/, and
# every platform component and the two app charts are children of it, synced automatically from
# then on. Applied via a local-exec (not `kubernetes_manifest`) deliberately: the Application CRD
# is registered by the argocd Helm release above, and Terraform's kubernetes_manifest resource
# needs a provider-level schema for CRDs that often aren't reliably known at plan time on a
# cluster created in the same apply — a well-documented rough edge. A plain `kubectl apply`
# after the CRD unambiguously exists is more reliable here than fighting that provider limitation.
resource "null_resource" "argocd_bootstrap" {
  depends_on = [helm_release.argocd]

  triggers = {
    root_app_sha = filesha256(var.gitops_root_app_path)
  }

  provisioner "local-exec" {
    command = <<-EOT
      aws eks update-kubeconfig --name ${module.eks.cluster_name} --region ${var.aws_region}
      kubectl apply -f ${var.gitops_root_app_path}
    EOT
  }
}
